<Application
    x:Class="EverySearch.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- System accent -> Spectrum blue, so stock controls (checkbox, focus, slider, combo) follow -->
            <Color x:Key="SystemAccentColor">#2680EB</Color>
            <Color x:Key="SystemAccentColorLight1">#378EF0</Color>
            <Color x:Key="SystemAccentColorLight2">#4B9CF5</Color>
            <Color x:Key="SystemAccentColorLight3">#5AA9FA</Color>
            <Color x:Key="SystemAccentColorDark1">#1473E6</Color>
            <Color x:Key="SystemAccentColorDark2">#0D66D0</Color>
            <Color x:Key="SystemAccentColorDark3">#095ABA</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="#2680EB" />

                        <!-- Palette brushes (dark values). Palette.Apply swaps their colours when the theme changes. -->
            <SolidColorBrush x:Key="ChromeBrush" Color="#212121" />
            <SolidColorBrush x:Key="RailBrush" Color="#252525" />
            <SolidColorBrush x:Key="PanelBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="TileBrush" Color="#343434" />
            <SolidColorBrush x:Key="BorderBrush1" Color="#3A3A3A" />
            <SolidColorBrush x:Key="BorderBrush2" Color="#4B4B4B" />
            <SolidColorBrush x:Key="TextBrush" Color="#EAEAEA" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#9B9B9B" />
            <SolidColorBrush x:Key="AccentTintBrush" Color="#26364D" />
            <SolidColorBrush x:Key="HoverVeilBrush" Color="#14FFFFFF" />

            <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="PanelHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>
            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>
            <Style x:Key="TitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Base button: flat, 4px radius, veil on hover -->
            <Style x:Key="BaseButton" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Veil.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Veil.Opacity" Value="1" />
                                                <Setter Target="Root.Opacity" Value="0.8" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Veil"
                                        Background="{ThemeResource HoverVeilBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <ContentPresenter Padding="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Accent pill: main call to action -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="18,0" />
            </Style>
            <!-- Outlined pill: secondary action -->
            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="BorderBrush" Value="{ThemeResource TextBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16,0" />
            </Style>
            <!-- Quiet text button -->
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}" />
            <!-- Square icon button for the tool rail -->
            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <!-- Selectable option tile (enhance modes, theme) -->
            <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{ThemeResource TileBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush2}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!-- Filter chip: outlined pill, filled with the accent when on -->
            <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{ThemeResource TileBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush2}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Padding" Value="11,0" />
            </Style>
            <Style x:Key="ChipButtonOn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Padding" Value="11,0" />
            </Style>

            <Style x:Key="BareListViewItem" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter HorizontalContentAlignment="Stretch" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
