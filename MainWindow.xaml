<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EverySearch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:EverySearch.Models"
    xmlns:local="using:EverySearch.Models">

    <Grid x:Name="Root"
          Background="{ThemeResource ChromeBrush}"
          BorderBrush="{ThemeResource BorderBrush2}"
          BorderThickness="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search box + match options -->
        <Grid Grid.Row="0" Margin="18,10,12,4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
            <TextBox x:Name="QueryBox"
                     Grid.Column="1"
                     PlaceholderText="Search every file and folder   (&gt; for commands)"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="20"
                     Height="48"
                     Padding="0,10,0,0"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{ThemeResource TextBrush}"
                     VerticalAlignment="Center"
                     TextChanged="QueryBox_TextChanged">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
            </TextBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="ScopeButton" Style="{StaticResource ChipButton}" Content="Entire PC" Click="ScopeButton_Click"
                        ToolTipService.ToolTip="Where to search: entire PC, drives or folders (Ctrl+D)" />
                <Button x:Name="SystemButton" Style="{StaticResource ChipButton}" Content="System" Click="SystemButton_Click"
                        ToolTipService.ToolTip="Include system, hidden and program files such as Windows, AppData, DLLs (Ctrl+S)" />
                <Button x:Name="PathButton" Style="{StaticResource ChipButton}" Content="Path" Click="PathButton_Click"
                        ToolTipService.ToolTip="Also match folder names (Ctrl+P)" />
                <Button x:Name="CaseButton" Style="{StaticResource ChipButton}" Content="Aa" Click="CaseButton_Click"
                        ToolTipService.ToolTip="Match case (Ctrl+I)" />
                <Button x:Name="ModeButton" Style="{StaticResource ChipButton}" Content="Contains" Click="ModeButton_Click"
                        ToolTipService.ToolTip="Pattern mode: contains / exact / wildcard / regex / fuzzy (Ctrl+M)" />
            </StackPanel>
        </Grid>

        <!-- Type chips (multi-select) + extension filter -->
        <Grid Grid.Row="1" Margin="18,2,12,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="ChipRow" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
            <TextBox x:Name="ExtBox"
                     Grid.Column="1"
                     Width="140"
                     MinHeight="28"
                     FontSize="12"
                     PlaceholderText="ext: pdf, docx"
                     ToolTipService.ToolTip="Extensions, comma separated (Ctrl+E)"
                     TextChanged="ExtBox_TextChanged" />
        </Grid>

        <Border Grid.Row="2" Background="{ThemeResource BorderBrush1}" />

        <!-- Results -->
        <Grid Grid.Row="3">
            <ListView x:Name="ResultList"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemContainerStyle="{StaticResource BareListViewItem}"
                      ItemClick="ResultList_ItemClick"
                      DoubleTapped="ResultList_DoubleTapped"
                      CanDragItems="True"
                      DragItemsStarting="ResultList_DragItemsStarting"
                      DragItemsCompleted="ResultList_DragItemsCompleted"
                      Padding="0,4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:ResultItem">
                        <Grid Height="52" Padding="16,0" Background="{x:Bind RowBackground, Mode=OneWay}" ColumnSpacing="12"
                              Tag="{x:Bind}" PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited"
                              RightTapped="Row_RightTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" HorizontalAlignment="Left" Margin="-16,8,0,8"
                                    Background="{StaticResource AccentBrush}"
                                    Visibility="{x:Bind BarVisibility, Mode=OneWay}" />
                            <Image Source="{x:Bind Icon}" Width="32" Height="32" VerticalAlignment="Center"
                                   Visibility="{x:Bind IconVisibility}" />
                            <Border Width="32" Height="32" CornerRadius="4" Background="{ThemeResource TileBrush}" VerticalAlignment="Center"
                                    Visibility="{x:Bind GlyphVisibility}">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource TextBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock local:Highlight.Text="{x:Bind Name}" local:Highlight.Terms="{x:Bind Terms}"
                                           FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Dir}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                                <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                <TextBlock Text="{x:Bind DateText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Ctrl + hover preview -->
            <Border x:Name="PreviewPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,16,10"
                    Width="400"
                    Padding="12"
                    CornerRadius="6"
                    IsHitTestVisible="False"
                    Background="{ThemeResource PanelBrush}"
                    BorderBrush="{ThemeResource BorderBrush2}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PreviewTitle" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <Grid MinHeight="140" MaxHeight="300">
                        <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="300" Visibility="Collapsed" />
                        <TextBlock x:Name="PreviewText" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                   TextWrapping="NoWrap" TextTrimming="Clip" MaxLines="20" Visibility="Collapsed" />
                        <TextBlock x:Name="PreviewNone" Text="No preview available" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="PreviewMeta" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" IsHitTestVisible="False">
                <TextBlock x:Name="EmptyTitle" Text="Type to search this whole PC" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyHint" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="ext:pdf   type:image,video   size:&gt;10mb   in:D:\Projects   folder:&#x0A;Pick types above, or press Ctrl+1…9" />
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{ThemeResource RailBrush}" BorderBrush="{ThemeResource BorderBrush1}" BorderThickness="0,1,0,0" Padding="16,7">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                           Text="↵ open   Ctrl+↵ show in folder   Hold Ctrl + hover: preview   Ctrl+C copy path   Esc close" />
            </Grid>
        </Border>

        <!-- Full-window overlay: first-run welcome and settings -->
        <Grid x:Name="Overlay" Grid.RowSpan="5" Visibility="Collapsed" Background="{ThemeResource ChromeBrush}">
            <StackPanel x:Name="WelcomePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="620" Spacing="12">
                <Image Width="72" Height="72" HorizontalAlignment="Left" x:Name="WelcomeIcon" />
                <TextBlock Text="Welcome to EverySearch" Style="{StaticResource TitleText}" />
                <TextBlock x:Name="WelcomeHotkey" FontSize="14" TextWrapping="Wrap" />
                <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextMutedBrush}" LineHeight="22"
                           Text="•  Type to find any file or folder on this PC, instantly.&#x0A;•  Pick types (Ctrl+1…9), an extension, or a scope: whole PC, drives or folders (Ctrl+D).&#x0A;•  Hold Ctrl and hover a result to preview it. Right-click for more actions.&#x0A;•  Type content:word to search inside text, Word, Excel and PowerPoint files.&#x0A;•  Type &gt; for commands and Settings. Files you open often rise to the top." />
                <Button Content="Get started" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="WelcomeDone_Click" />
            </StackPanel>

            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" Padding="32,24">
                <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Settings" Style="{StaticResource TitleText}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="OPEN SHORTCUT" Style="{StaticResource PanelHeader}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="SettingsHotkey" FontSize="14" VerticalAlignment="Center" />
                            <Button Content="Change…" Style="{StaticResource SecondaryButton}" Click="SettingsHotkey_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="THEME" Style="{StaticResource PanelHeader}" />
                        <ComboBox x:Name="ThemeBox" Width="200">
                            <ComboBoxItem Content="Follow Windows" />
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                        </ComboBox>
                    </StackPanel>

                    <ToggleSwitch x:Name="AutostartSwitch" Header="Start with Windows (runs quietly in the tray)" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="RESCAN EVERY (MINUTES, 5 OR MORE)" Style="{StaticResource PanelHeader}" />
                        <TextBox x:Name="RescanBox" Width="120" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="FOLDERS TO INDEX (ONE PER LINE; EMPTY = ALL DRIVES)" Style="{StaticResource PanelHeader}" />
                        <TextBox x:Name="RootsBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="76" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="NEVER INDEX (FOLDER NAMES OR FULL PATHS, ONE PER LINE)" Style="{StaticResource PanelHeader}" />
                        <TextBox x:Name="ExcludesBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="76" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="SettingsSave_Click" />
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="SettingsCancel_Click" />
                        <Button Content="Forget what I opened" Style="{StaticResource GhostButton}" Click="SettingsForget_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
